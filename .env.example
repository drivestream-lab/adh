# adh — copy to .env for local development

APP_PORT=8080
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_LOG_TO_CONSOLE=true
APP_LOG_DIR=logs
APP_RELOAD=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adh
POSTGRES_PASSWORD=adh
POSTGRES_DB=buzz
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=adh_buzz:
REDIS_DEFAULT_TTL=3600

JWT_ALGORITHM=RS256
JWT_ISSUER=adh
JWT_AUDIENCE=drivestream
JWT_PUBLIC_KEY_PATH=tests/fixtures/jwt_public.pem

HERMES_LITELLM_BASE_URL=http://localhost:4000/v1
HERMES_LITELLM_API_KEY=sk-adh-local-master
HERMES_MODEL=qwen
HERMES_PG_HOST=localhost
HERMES_PG_DB=hermes
HERMES_LEDGER_DB=ledger
HERMES_RUN_BOOT_JOBS=false
HERMES_LISTEN_OPS=true
HERMES_PM_SKILL_RUNNER_ENABLED=true
HERMES_LITELLM_CONCURRENCY=2
# Buzz still-working cadence while Cursor skills run (seconds × loops)
HERMES_WAIT_STEP_SECONDS=90
HERMES_PROGRESS_SECONDS=90
HERMES_WAIT_STEPS=40
HERMES_TIMEOUT_SECONDS=3600
# Redis TTL for open briefs / judgment+authorize (default 2 days)
HERMES_SESSION_TTL_SECONDS=172800
HERMES_PM_MAX_THINK_RUNS=4
# Validate passes where Hermes decides VFs after posting recommend+why (0 = Lead always)
# HERMES_PM_AUTO_DECIDE_VALIDATE_PASSES=1
# Host worker: make hermes-worker (Buzz Docker uses HERMES_LISTEN_OPS=false)

ORCH_BUZZ_BASE_URL=http://localhost:8080
ORCH_OPS_ROOM=adh-ops
ORCH_CURSOR_BIN=agent
ORCH_CURSOR_TIMEOUT_SECONDS=3600
ORCH_HEARTBEAT_SECONDS=90
ORCH_ENABLE_SPAWN=false
ORCH_GITHUB_ORG=drivestream-lab
ORCH_WORKSPACE_ROOT=
ORCH_META_ROOT=

# OpenTelemetry — off by default locally (no Alloy/collector → export ERROR spam).
# Set OTEL_ENABLED=true when OTLP endpoint is reachable.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=adh
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
