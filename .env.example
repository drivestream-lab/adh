# adh — copy to .env for local development

APP_PORT=8080
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_LOG_TO_CONSOLE=true
APP_LOG_DIR=logs
APP_RELOAD=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adh
POSTGRES_PASSWORD=adh
POSTGRES_DB=buzz
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=adh_buzz:
REDIS_DEFAULT_TTL=3600

JWT_ALGORITHM=RS256
JWT_ISSUER=adh
JWT_AUDIENCE=drivestream
JWT_PUBLIC_KEY_PATH=tests/fixtures/jwt_public.pem

HERMES_LITELLM_BASE_URL=http://localhost:4000/v1
HERMES_LITELLM_API_KEY=sk-adh-local-master
HERMES_MODEL=qwen
HERMES_PG_HOST=localhost
HERMES_PG_DB=hermes
HERMES_LEDGER_DB=ledger
HERMES_RUN_BOOT_JOBS=false

OTEL_SERVICE_NAME=adh
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
